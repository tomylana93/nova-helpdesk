{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "serena": {
            "type": "remote",
            "enabled": true,
            "url": "http://localhost:9121/mcp"
        },
        "context7": {
            "type": "local",
            "enabled": true,
            "args": [
                "pnpm",
                "dlx",
                "@upstash/context7-mcp"
            ]
        },
        "shadcn": {
            "type": "local",
            "enabled": true,
            "command": [
                "pnpm",
                "dlx",
                "shadcn-vue@latest",
                "mcp"
            ]
        }
    }
}