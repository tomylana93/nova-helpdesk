# Local deploy configuration for ./deploy.sh — copy to .env.deploy and fill in.
# .env.deploy is git-ignored: keep environment-specific infra targets out of the repo.
#
#   cp .env.deploy.example .env.deploy
#   # edit values below, then:
#   ./deploy.sh vX.Y.Z
#
# These are infra targets, not secrets. Production credentials live only in
# the server-provisioned /srv/nova-helpdesk/shared/.env.

# SSH target for the production VPS (user@host).
DEPLOY_HOST=deployer@your-server-host

# Base directory on the server holding releases/, shared/, and current.
DEPLOY_ROOT=/srv/nova-helpdesk

# Public Reverb (WebSocket) host baked into the local asset build.
REVERB_HOST=helpdesk.example.com

# Public Reverb app key baked into the client bundle so the browser can open the
# WebSocket. Client-exposed (not a secret), but REQUIRED: without it the build
# bakes key:undefined and the notification bell crashes at setup in production.
# Must match REVERB_APP_KEY in the server-provisioned /srv/nova-helpdesk/shared/.env.
REVERB_APP_KEY=your-reverb-app-key

# Optional — sensible defaults applied by deploy.sh if unset.
REVERB_PORT=443
REVERB_SCHEME=https
KEEP_RELEASES=3
